config gwifi 'config'
	option srv_ip ''
	option nas_name ''
	option aes_key ''
	option interval '3'
	option check_url ''
	option check_code '200'
	option backup_code '200'
	option payload_encoding 'form'
	option auto_metric '1'
	option default_ttl '0'
	option enable_mac_spoof '0'
	option enable_cron '0'
	option nas_monitor '0'
	option ttl_watch '0'
	option ttl_interval '3'
	option rebind '0'
	option nas_check_interval '1'

config line 'wan_line'
	option enabled '0'
	option iface 'wan'
	option account ''
	option password ''
	option spoof_device 'tablet'
	option nas_name ''
	option srv_ip ''
	option aes_key ''
