#!/bin/sh
# Route new LAN connections through a verified spare; existing unmarked
# connections retain the main table. Each generation keeps its own mark/table.
umask 077
. /lib/functions.sh
. /lib/functions/network.sh
. /usr/lib/gwifi/common.sh
gwifi_operation_lock || exit 75
STATE=/var/run/gwifi-handover
mkdir -p "$STATE"
exec 5>/var/run/gwifi-handover.lock
flock -n 5 || exit 75
config_load gwifi
log() { logger -t gwifi-nas "$*"; }
set_state() {
 [ "$(uci -q get gwifi.$1.migration_state)" = "$2" ] && return
 uci set gwifi.$1.migration_state="$2"
 uci commit gwifi
}
valid_section() { case "$1" in ''|*[!a-zA-Z0-9_]*) return 1;; esac; [ "$(uci -q get gwifi.$1)" = line ]; }
route_table() {
 local section="$1" table="$2" iface dev addr gw route
 config_get iface "$section" iface
 dev=$(gwifi_device "$iface") || return 1
 addr=$(ip -4 addr show dev "$dev" | awk '/inet / {split($2,a,"/");print a[1];exit}')
 gwifi_ipv4 "$addr" || return 1
 network_get_gateway gw "$iface" || gw=
 [ -n "$gw" ] || gw=$(ip -4 route show default dev "$dev" | awk '/via/{print $3;exit}')
 gwifi_ipv4 "$gw" || return 1
 # Preserve reachability of all currently connected networks and LAN.
 ip -4 route show table main | sed '/^default /d' | while IFS= read -r route; do
  [ -z "$route" ] || ip -4 route replace table "$table" $route 2>/dev/null || true
 done
 # DHCP gateway must be reachable in the new table even for a host route lease.
 ip -4 route replace "$gw/32" dev "$dev" scope link table "$table" || return 1
 ip -4 route replace default via "$gw" dev "$dev" src "$addr" table "$table"
}
render_rules() {
 local current="$1" slot mark lan file out
 lan=$(uci -q get network.lan.device)
 [ -n "$lan" ] || lan=br-lan
 case "$lan" in *[!a-zA-Z0-9_.:-]*) return 1;; esac
 out=$(mktemp /var/run/gwifi-handover-rules.XXXXXX) || return 1
 if nft list table inet gwifi_handover >/dev/null 2>&1; then echo 'delete table inet gwifi_handover' >> "$out"; fi
 {
  echo 'table inet gwifi_handover {'
  echo 'chain lan_connections {'
  echo 'type filter hook prerouting priority -140; policy accept;'
  for file in "$STATE"/slot-*; do
   [ -f "$file" ] || continue
   slot=$(basename "$file" | cut -d- -f2)
   mark=$((1191182336 + slot))
   echo "iifname \"$lan\" ct mark $mark meta mark set ct mark"
  done
  if [ -n "$current" ]; then
   mark=$((1191182336 + current))
   echo "iifname \"$lan\" ct state new ct mark 0 meta mark 0 meta mark set $mark ct mark set meta mark"
  fi
  echo '}'
  echo '}'
 } >> "$out"
 nft -c -f "$out" && nft -f "$out"
 result=$?
 rm -f "$out"
 return "$result"
}
case "$1" in
 prepare)
  SOURCE="$2"; SPARE="$3"
  valid_section "$SOURCE" && valid_section "$SPARE" || exit 1
  [ "$(uci -q get gwifi.$SPARE.enabled)" = 1 ] || exit 1
  [ "$(uci -q get gwifi.$SPARE.manual_hold)" != 1 ] || exit 1
  config_get iface "$SOURCE" iface
  SRC_DEV=$(gwifi_device "$iface") || exit 1
  config_get iface "$SPARE" iface
  SPARE_DEV=$(gwifi_device "$iface") || exit 1
  [ "$(gwifi_parent "$SRC_DEV")" = "$(gwifi_parent "$SPARE_DEV")" ] || exit 1
  MAIN=$(ip -4 route show table main default | head -1 | awk '{for(i=1;i<=NF;i++)if($i=="dev")print $(i+1)}')
  if [ "$MAIN" != "$SRC_DEV" ]; then set_state "$SOURCE" verified_nondefault; exit 3; fi
  config_get url config check_url http://www.baidu.com
  config_get code config check_code 200
  gwifi_probe "$SPARE_DEV" "$url" "$code" || exit 1
  CURRENT=$(cat "$STATE/current" 2>/dev/null)
  if [ -n "$CURRENT" ] && [ "$(cat "$STATE/slot-$CURRENT" 2>/dev/null)" = "$SOURCE $SPARE" ]; then
   REUSE_TABLE=$((23000+CURRENT)); REUSE_MARK=$((1191182336+CURRENT)); REUSE_PREF=$((12000+CURRENT))
   HEX_MARK=$(printf '0x%x' "$REUSE_MARK")
   if ! ip -4 rule show | grep -qF "fwmark $HEX_MARK lookup $REUSE_TABLE"; then
    ip -4 rule show | grep -q "lookup $REUSE_TABLE" && exit 1
    ip -4 rule add pref "$REUSE_PREF" fwmark "$REUSE_MARK/0xffffffff" table "$REUSE_TABLE" || exit 1
   fi
   route_table "$SPARE" "$((23000+CURRENT))" && render_rules "$CURRENT" || exit 1
   set_state "$SOURCE" active
   exit 0
  fi
  SLOT=$(cat "$STATE/next" 2>/dev/null)
  case "$SLOT" in ''|*[!0-9]*) SLOT=1;; esac
  [ "$SLOT" -lt 200 ] || { log '迁移次数已达本次启动上限，请检查线路稳定性'; exit 1; }
  TABLE=$((23000 + SLOT)); MARK=$((1191182336 + SLOT)); PREF=$((12000 + SLOT))
  # Refuse to take tables/marks owned by another plugin.
  [ -z "$(ip -4 route show table "$TABLE" 2>/dev/null)" ] || exit 1
  ip rule show | grep -q "lookup $TABLE" && exit 1
  route_table "$SPARE" "$TABLE" || { ip route flush table "$TABLE"; exit 1; }
  if ! ip rule add pref "$PREF" fwmark "$MARK/0xffffffff" table "$TABLE"; then ip route flush table "$TABLE"; exit 1; fi
  printf '%s %s\n' "$SOURCE" "$SPARE" > "$STATE/slot-$SLOT"
  if render_rules "$SLOT"; then
   printf '%s\n' "$SLOT" > "$STATE/current"
   printf '%s\n' "$((SLOT+1))" > "$STATE/next"
   set_state "$SOURCE" active
   log "[$SOURCE] 新发起的 LAN 连接改走 $SPARE；已有连接继续使用原出口"
  else
   ip rule del pref "$PREF" fwmark "$MARK/0xffffffff" table "$TABLE"
   ip route flush table "$TABLE"
   rm -f "$STATE/slot-$SLOT"
   log "[$SOURCE] 切换出口失败，原出口保持不变"
   exit 1
  fi
 ;;
 check)
  CURRENT=$(cat "$STATE/current" 2>/dev/null)
  [ -n "$CURRENT" ] || exit 0
  read -r SOURCE SPARE < "$STATE/slot-$CURRENT" || exit 1
  config_get_bool ENABLE config nas_monitor 0
  if [ "$ENABLE" != 1 ] || [ "$(uci -q get gwifi.$SPARE.enabled)" != 1 ] || [ "$(uci -q get gwifi.$SPARE.manual_hold)" = 1 ]; then render_rules '' || exit 1; set_state "$SOURCE" fallback; exit; fi
  config_get iface "$SPARE" iface
  DEV=$(gwifi_device "$iface") || DEV=
  config_get url config check_url http://www.baidu.com
  config_get code config check_code 200
  if [ -n "$DEV" ] && gwifi_probe "$DEV" "$url" "$code" && route_table "$SPARE" "$((23000+CURRENT))"; then
   render_rules "$CURRENT" || exit 1
   set_state "$SOURCE" active
  else
   render_rules '' || exit 1
   [ "$(uci -q get gwifi.$SOURCE.migration_state)" = fallback ] || log "[$SOURCE] 备用出口当前无法联网，新连接恢复使用原默认出口"
   set_state "$SOURCE" fallback
  fi
 ;;
 *) exit 2;;
esac
