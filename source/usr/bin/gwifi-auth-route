#!/bin/sh
# Repair the existing per-vwan authentication route without changing main.
. /lib/functions.sh
. /lib/functions/network.sh
. /usr/lib/gwifi/common.sh
iface="$1"
case "$iface" in ''|*[!a-zA-Z0-9_.:-]*) exit 2;; esac
dev=$(gwifi_device "$iface") || exit 1
gwifi_operation_lock || exit 75
num=
case "$dev" in vwan*) num=${dev#vwan};; esac
case "$num" in ''|*[!0-9]*) num=;; esac
if [ -n "$num" ] && [ "${#num}" -le 3 ]; then
 num=$(printf '%s' "$num" | sed 's/^0*//'); num=${num:-0}
 table=$((100+num)); pref=$((50+num))
else
 num=$(cat /sys/class/net/"$dev"/ifindex)
 case "$num" in ''|*[!0-9]*) exit 1;; esac
 [ "$num" -lt 10000 ] || exit 1
 table=$((10000+num)); pref=$((10000+num))
fi
addr=$(gwifi_ipaddr "$iface" "$dev")
gwifi_ipv4 "$addr" || exit 1
network_get_gateway gw "$iface" || gw=$(ip -4 route show default dev "$dev" | awk '/via/{print $3;exit}')
gwifi_ipv4 "$gw" || exit 1
exec 8>"/var/run/gwifi-auth-route-$dev.lock"
flock -n 8 || exit 0
# Respect a table already used by another interface.
others=$(ip -4 route show table "$table" 2>/dev/null | awk -v d="$dev" '{for(i=1;i<NF;i++)if($i=="dev" && $(i+1)!=d)print $(i+1)}')
[ -z "$others" ] || { logger -t gwifi-route "$dev: table $table belongs to another device; unchanged"; exit 1; }
ip -4 route replace "$gw/32" dev "$dev" scope link table "$table" || exit 1
ip -4 route replace default via "$gw" dev "$dev" src "$addr" table "$table" || exit 1
ip -4 rule show | grep -q "oif $dev lookup $table" || ip -4 rule add oif "$dev" table "$table" pref "$pref"
