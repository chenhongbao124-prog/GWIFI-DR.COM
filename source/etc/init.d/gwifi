#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
start_service() {
 local job
 for job in login ttl nas route; do
  procd_open_instance "$job"
  procd_set_param command /usr/bin/gwifi-background "$job"
  procd_set_param respawn 3600 5 5
  procd_close_instance
 done
}
service_triggers() { procd_add_reload_trigger gwifi; }
reload_service() { stop; start; }
